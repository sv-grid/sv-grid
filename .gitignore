# Private / commercial - kept out of the public repo (still built locally).
# The marketing website lives in a PRIVATE repo, mounted here as a git submodule
# (see .gitmodules). It is NOT ignored - the parent tracks a submodule pointer.

# SvGrid Studio - the commercial visual designer (the "seller"). The codegen
# stays public (@svgrid/enterprise/studio, used by the MCP server); only the
# visual designer UI + its demos are private. Re-exported locally via the
# git-ignored @svgrid/enterprise/designer barrel.
packages/enterprise/src/SvStudioDesigner.svelte
packages/enterprise/src/SvSchemaDesigner.svelte
packages/enterprise/src/studio-designer.ts
packages/enterprise/designer-app/
examples/src/demos/192-data-app-studio.svelte
examples/src/demos/201-studio-designer.svelte

# Dependencies
node_modules/
.pnpm-store/

# Build output (CI rebuilds these; never commit)
dist/
build/
.svelte-kit/
.vercel/
*.tsbuildinfo

# Vite temp files
vite.config.*.timestamp-*
vite.config.*.timestamp_*

# Env files (keep the documented examples)
.env
.env.*
!.env.example

# Test / coverage artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Generated per-customer license files and the issuance audit log.
# These contain real customer-bound license keys and must never be
# committed to the public repo. The issuer script lives at
# tools/issue-license.mjs (committed) and writes here.
tools/licenses/

# One-off / scratch scripts kept locally but not part of the product build.
extract-part.mjs

# Generated PDF (rebuilt from docs/legal/EULA.md by tools/eula-to-pdf.mjs).
docs/legal/SvGrid-EULA.pdf
