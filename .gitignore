# Private / commercial - kept out of the public repo.
# The marketing website (which also owns the private SvGrid Studio visual
# designer under website/src/lib/designer + website/designer-app) lives in a
# PRIVATE repo, mounted here as a git submodule (see .gitmodules). It is NOT
# ignored - the parent tracks a submodule pointer. The public @svgrid/enterprise
# keeps only the Studio *codegen* (@svgrid/enterprise/studio), which the MCP
# server depends on.

# Dependencies
node_modules/
.pnpm-store/

# Build output (CI rebuilds these; never commit)
dist/
build/

# Internal go-to-market / SEO strategy docs + GSC exports + analysis tooling.
# NEVER commit to the public repo (launch copy, backlink plans, traffic data).
marketing/

# Automated tweet scratch output (rendered card + preview)
.tweet-out/
.svelte-kit/
.vercel/
*.tsbuildinfo

# Vite temp files
vite.config.*.timestamp-*
vite.config.*.timestamp_*

# Automated tweet scratch output (rendered card / preview media)
.tweet-out/

# Env files (keep the documented examples)
.env
.env.*
!.env.example

# Test / coverage artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Generated per-customer license files and the issuance audit log.
# These contain real customer-bound license keys and must never be
# committed to the public repo. The issuer script lives at
# tools/issue-license.mjs (committed) and writes here.
tools/licenses/

# One-off / scratch scripts kept locally but not part of the product build.
extract-part.mjs

# Generated PDF (rebuilt from docs/legal/EULA.md by tools/eula-to-pdf.mjs).
docs/legal/SvGrid-EULA.pdf

# NOTE: a blanket `*.mjs` used to live here (alongside `tools/prerender-site.mjs`).
# Both were mistakes: they are no-ops for already-tracked files, but they silently
# hid every NEW .mjs from `git status` - including build scripts that
# package.json invokes (`tools/count-demos.mjs`, `packages/enterprise/scripts/
# build-designer.mjs`). Ignore scratch scripts by name, never by extension.

# Maintainer-only tooling under tools/ - kept locally, never in the public repo.
# tools/ CANNOT be ignored wholesale: 5 workflows and both package.json script
# sets invoke ~25 scripts there (build-docs-index, prerender-site, release-grid,
# post-tweet + twitter/*, the *.test.ts files, ...). Ignoring the folder would
# break CI. Only the scripts with no build/CI dependency are listed here, by
# name - never by extension (see the blanket `*.mjs` note above).

# Commercial / credential-adjacent
tools/issue-license.mjs
tools/gh-secrets.ps1
tools/publish.mjs
tools/eula-to-pdf.mjs

# GitHub + Discussions ops (posting runs on say-so only)
tools/gh.mjs
tools/simulate-issues.mjs
tools/seed-discussions.mjs

# Marketing / SEO / launch-asset generation (pairs with the ignored marketing/)
tools/blog-internal-links.mjs
tools/blog-pillars.mjs
tools/capture-launch-assets.mjs
tools/make-brand-logo.mjs

# One-off blog + demo maintenance scripts (not wired into any build)
tools/assign-blog-authors.mjs
tools/backfill-demo-embeds.mjs
tools/blog-add-images.mjs
tools/blog-screenshots.mjs
tools/insert-blog-images.mjs
tools/build-demo-prompts.mjs
tools/build-recipe-stubs.mjs
tools/capture-readme-hero.mjs
tools/capture-studio-shots.mjs
tools/check-links.mjs
tools/measure-bundle.mjs
