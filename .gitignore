# Private / commercial - kept out of the public repo.
# The marketing website (which also owns the private SvGrid Studio visual
# designer under website/src/lib/designer + website/designer-app) lives in a
# PRIVATE repo, mounted here as a git submodule (see .gitmodules). It is NOT
# ignored - the parent tracks a submodule pointer. The public @svgrid/enterprise
# keeps only the Studio *codegen* (@svgrid/enterprise/studio), which the MCP
# server depends on.

# Dependencies
node_modules/
.pnpm-store/

# Build output (CI rebuilds these; never commit)
dist/
build/

# Automated tweet scratch output (rendered card + preview)
.tweet-out/
.svelte-kit/
.vercel/
*.tsbuildinfo

# Vite temp files
vite.config.*.timestamp-*
vite.config.*.timestamp_*

# Automated tweet scratch output (rendered card / preview media)
.tweet-out/

# Env files (keep the documented examples)
.env
.env.*
!.env.example

# Test / coverage artifacts
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Generated per-customer license files and the issuance audit log.
# These contain real customer-bound license keys and must never be
# committed to the public repo. The issuer script lives at
# tools/issue-license.mjs (committed) and writes here.
tools/licenses/

# One-off / scratch scripts kept locally but not part of the product build.
extract-part.mjs

# Generated PDF (rebuilt from docs/legal/EULA.md by tools/eula-to-pdf.mjs).
docs/legal/SvGrid-EULA.pdf
