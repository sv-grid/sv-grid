# Drizzle
# Leave empty to use the embedded PGlite database (.data/pglite).
DATABASE_URL=""

ORIGIN="http://localhost:5173"

# Better Auth
# Signs sessions. `npm run dev` creates one on first run; in production set your own:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (password reset). Leave empty to print emails to the server console.
# https://resend.com/docs/api-reference/emails/send-email
RESEND_API_KEY=""
EMAIL_FROM=""

# Stripe billing. Leave empty to run without billing (the billing page says so).
# Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_PRICE_PRO is a recurring price id (price_...) from your Pro product.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to localhost:5173/api/stripe/webhook`
# locally, or from the endpoint you add in the dashboard for production.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_WEBHOOK_SECRET=""
