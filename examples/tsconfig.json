{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "useDefineForClassFields": true,
    "module": "esnext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.svelte",
    "../vite-env.d.ts"
  ],
  // Local-only bench adapters (gitignored, see src/bench/adapters.ts) import
  // packages that are not in this manifest; they are loaded through
  // import.meta.glob, so leaving them out of the check loses nothing.
  "exclude": ["src/bench/*.local.ts"]
}
