{
  "name": "@svgrid/grid",
  "version": "2.6.16",
  "description": "Svelte 5-native data grid and data table. Headless-first engine with virtual scrolling for 100k+ rows, Excel-style filtering, inline editing, grouping, tree data, pivot, and server-side data. Drop-in <SvGrid> component. TypeScript, SSR-ready.",
  "author": "jQWidgets <boikom@jqwidgets.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sv-grid/sv-grid.git",
    "directory": "packages/grid"
  },
  "homepage": "https://svgrid.com",
  "funding": {
    "type": "commercial",
    "url": "https://svgrid.com/pricing"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "svelte-5",
    "sveltekit",
    "grid",
    "data grid",
    "data-grid",
    "datagrid",
    "svelte data grid",
    "svelte-data-grid",
    "table",
    "data table",
    "data-table",
    "datatable",
    "svelte table",
    "svelte-table",
    "headless",
    "headless-table",
    "virtual-scroll",
    "spreadsheet",
    "typescript",
    "svgrid"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/sv-grid-scrollbar.*"
  ],
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "svelte": "./dist/index.js",
  "unpkg": "./dist/cdn/svgrid.js",
  "jsdelivr": "./dist/cdn/svgrid.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./cdn": {
      "import": "./dist/cdn/svgrid.js",
      "default": "./dist/cdn/svgrid.js"
    },
    "./cdn/svelte-external": {
      "import": "./dist/cdn/svgrid.svelte-external.js",
      "default": "./dist/cdn/svgrid.svelte-external.js"
    },
    "./core": {
      "types": "./dist/headless.d.ts",
      "svelte": "./dist/headless.js",
      "import": "./dist/headless.js"
    },
    "./static-functions": {
      "types": "./dist/static-functions.d.ts",
      "svelte": "./dist/static-functions.js",
      "import": "./dist/static-functions.js"
    },
    "./format": {
      "types": "./dist/export-format.d.ts",
      "svelte": "./dist/export-format.js",
      "import": "./dist/export-format.js"
    },
    "./filtering": {
      "types": "./dist/filtering/excel-filters.d.ts",
      "svelte": "./dist/filtering/excel-filters.js",
      "import": "./dist/filtering/excel-filters.js"
    },
    "./flex-render": {
      "types": "./dist/flex-render.d.ts",
      "svelte": "./dist/flex-render.js",
      "import": "./dist/flex-render.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "svelte": "./dist/themes/index.js",
      "import": "./dist/themes/index.js"
    },
    "./themes/*.css": "./themes/*.css",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist",
    "src",
    "themes",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "rimraf ./build && rimraf ./dist",
    "test:eslint": "eslint ./src",
    "test:types": "svelte-check --tsconfig ./tsconfig.json",
    "test:lib": "vitest run --coverage",
    "test:build": "publint --strict",
    "build": "svelte-package --input ./src --output ./dist && node ../../tools/strip-dist-tests.mjs ./dist && node ./scripts/build-cdn.mjs && node ./scripts/build-themes.mjs",
    "lint": "eslint ./src"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "axe-core": "^4.13.0",
    "eslint-plugin-svelte": "^3.17.1",
    "jsdom": "^29.1.1",
    "publint": "^0.3.21",
    "svelte": "^5.55.5",
    "svelte-check": "^4.4.6"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
