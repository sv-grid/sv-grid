{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@svgrid/ui recipe registry",
  "description": "Recipes the @svgrid/ui CLI can add or try. Items under a blocks/<group> group are generated by tools/sync-block-recipes.mjs from the Blocks demos; do not edit them by hand.",
  "type": "object",
  "required": ["groups", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "groups": {
      "type": "object",
      "description": "Group id -> members. `npx @svgrid/ui add <group-id>` adds every member.",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "items"],
        "properties": {
          "title": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        },
        "additionalProperties": false
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "deps", "files", "group"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string" },
          "export": { "type": "string", "description": "The @svgrid/grid export to name in the 'Use it' hint, when it is not Sv + PascalCase(id)." },
          "description": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "deps": { "type": "array", "items": { "type": "string" } },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["write", "from"],
              "properties": {
                "write": { "type": "string", "description": "File name written into the user's components dir." },
                "from": { "type": "string", "description": "Path under recipes/." }
              },
              "additionalProperties": false
            }
          },
          "group": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
