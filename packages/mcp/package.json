{
  "name": "@svgrid/mcp",
  "mcpName": "com.svgrid/svgrid",
  "funding": {
    "type": "commercial",
    "url": "https://svgrid.com/pricing"
  },
  "version": "2.6.7",
  "description": "Model Context Protocol server for SvGrid, the Svelte 5 data grid: checks the code your AI writes against the real API surface, plus version-pinned docs, API reference and 373 demo sources.",
  "license": "MIT",
  "author": "jQWidgets <sales@jqwidgets.com>",
  "homepage": "https://svgrid.com/docs/help/mcp-server/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sv-grid/sv-grid.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "svgrid-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:manifests": "node ./scripts/build-manifests.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build:mcpb": "node ./scripts/build-mcpb.mjs",
    "build": "pnpm build:manifests && pnpm build:ts",
    "prepublishOnly": "pnpm build",
    "start": "node dist/index.js",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ./src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@svgrid/enterprise": "workspace:^",
    "svelte": "^5.55.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "model-context-protocol",
    "ai",
    "llm",
    "claude",
    "cursor",
    "zed",
    "svelte",
    "svelte5",
    "data grid",
    "datagrid",
    "svgrid",
    "sv-grid",
    "codegen",
    "agent",
    "validation",
    "verify",
    "lint",
    "svelte-check",
    "code-verification"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js"
    },
    "./search": {
      "types": "./dist/search.d.ts",
      "import": "./dist/search.js"
    },
    "./data": {
      "types": "./dist/data.d.ts",
      "import": "./dist/data.js"
    },
    "./package.json": "./package.json"
  }
}
