{
  "name": "@svgrid/enterprise",
  "funding": {
    "type": "commercial",
    "url": "https://svgrid.com/pricing"
  },
  "version": "2.7.0",
  "description": "Enterprise feature pack for SvGrid: Excel (xlsx) and PDF export, Excel/CSV/JSON import, pivot tables with a drag-and-drop designer, paginated print, Kanban board and scheduler renderers, no-code alerts and batch editing. CSV, TSV and JSON export are already free in @svgrid/grid. Requires a paid license key.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "jQWidgets <sales@jqwidgets.com>",
  "homepage": "https://svgrid.com/pricing",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "svelte": "./dist/export.js",
      "import": "./dist/export.js"
    },
    "./print": {
      "types": "./dist/print.d.ts",
      "svelte": "./dist/print.js",
      "import": "./dist/print.js"
    },
    "./import": {
      "types": "./dist/import.d.ts",
      "svelte": "./dist/import.js",
      "import": "./dist/import.js"
    },
    "./pivot": {
      "types": "./dist/pivot.d.ts",
      "svelte": "./dist/pivot.js",
      "import": "./dist/pivot.js"
    },
    "./license": {
      "types": "./dist/license.d.ts",
      "svelte": "./dist/license.js",
      "import": "./dist/license.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "node": "./dist/node/studio.js",
      "svelte": "./dist/studio/index.js",
      "import": "./dist/studio/index.js"
    },
    "./cdn/svelte-external": {
      "import": "./dist/cdn/svgrid-enterprise.svelte-external.js",
      "default": "./dist/cdn/svgrid-enterprise.svelte-external.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/cdn/svgrid-enterprise.svelte-external.js",
  "jsdelivr": "./dist/cdn/svgrid-enterprise.svelte-external.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "build": "svelte-package --input ./src --output ./dist && node ../../tools/strip-dist-tests.mjs ./dist && node ../../tools/add-dist-extensions.mjs ./dist && node ./scripts/build-cdn.mjs && node ./scripts/build-node.mjs && node ./scripts/build-designer.mjs",
    "build:lib": "svelte-package --input ./src --output ./dist && node ../../tools/strip-dist-tests.mjs ./dist && node ../../tools/add-dist-extensions.mjs ./dist",
    "build:cdn": "node ./scripts/build-cdn.mjs",
    "build:node": "node ./scripts/build-node.mjs",
    "build:designer": "node ./scripts/build-designer.mjs",
    "prepublishOnly": "svelte-package --input ./src --output ./dist && node ../../tools/strip-dist-tests.mjs ./dist && node ./scripts/build-cdn.mjs && node ./scripts/build-node.mjs && node ./scripts/build-designer.mjs",
    "extract:ui-props": "node scripts/extract-ui-props.mjs",
    "lint": "eslint ./src"
  },
  "peerDependencies": {
    "@svgrid/grid": "workspace:^",
    "jszip": "^3.10.0",
    "pdfmake": "^0.2.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "jszip": {
      "optional": true
    },
    "pdfmake": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@svgrid/grid": "workspace:^",
    "jszip": "^3.10.1",
    "pdfmake": "^0.2.10",
    "svelte": "^5.55.5",
    "typescript": "6.0.3",
    "vite": "^8.2.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sv-grid/sv-grid.git",
    "directory": "packages/enterprise"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "data grid",
    "datagrid",
    "data table",
    "excel export",
    "xlsx",
    "pdf export",
    "csv",
    "pivot table",
    "pivot",
    "import",
    "print",
    "kanban",
    "scheduler",
    "svgrid",
    "sv-grid"
  ]
}
