{
  "name": "@svgrid/enterprise",
  "funding": {
    "type": "commercial",
    "url": "https://svgrid.com/pricing"
  },
  "version": "2.3.1",
  "description": "Enterprise feature pack for SvGrid: Excel (xlsx), PDF, CSV, TSV and HTML export, Excel/CSV/JSON import, pivot tables with a drag-and-drop designer, paginated print, Kanban board and scheduler views. Requires a paid license key.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "jQWidgets <sales@jqwidgets.com>",
  "homepage": "https://svgrid.com/pricing",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./export": {
      "types": "./src/export.ts",
      "svelte": "./src/export.ts",
      "import": "./src/export.ts"
    },
    "./print": {
      "types": "./src/print.ts",
      "svelte": "./src/print.ts",
      "import": "./src/print.ts"
    },
    "./import": {
      "types": "./src/import.ts",
      "svelte": "./src/import.ts",
      "import": "./src/import.ts"
    },
    "./pivot": {
      "types": "./src/pivot.ts",
      "svelte": "./src/pivot.ts",
      "import": "./src/pivot.ts"
    },
    "./studio": {
      "types": "./src/studio/index.ts",
      "node": "./dist/node/studio.js",
      "svelte": "./src/studio/index.ts",
      "import": "./src/studio/index.ts"
    },
    "./cdn/svelte-external": {
      "import": "./dist/cdn/svgrid-enterprise.svelte-external.js",
      "default": "./dist/cdn/svgrid-enterprise.svelte-external.js"
    },
    "./package.json": "./package.json"
  },
  "unpkg": "./dist/cdn/svgrid-enterprise.svelte-external.js",
  "jsdelivr": "./dist/cdn/svgrid-enterprise.svelte-external.js",
  "files": [
    "src",
    "dist/node",
    "dist/cdn",
    "dist/designer",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "build": "node ./scripts/build-cdn.mjs && node ./scripts/build-node.mjs && node ./scripts/build-designer.mjs",
    "build:cdn": "node ./scripts/build-cdn.mjs",
    "build:node": "node ./scripts/build-node.mjs",
    "build:designer": "node ./scripts/build-designer.mjs",
    "prepublishOnly": "node ./scripts/build-cdn.mjs && node ./scripts/build-node.mjs && node ./scripts/build-designer.mjs",
    "extract:ui-props": "node scripts/extract-ui-props.mjs",
    "lint": "eslint ./src"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "@svgrid/grid": "workspace:^",
    "jszip": "^3.10.0",
    "pdfmake": "^0.2.0"
  },
  "peerDependenciesMeta": {
    "jszip": {
      "optional": true
    },
    "pdfmake": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "jszip": "^3.10.1",
    "pdfmake": "^0.2.10",
    "svelte": "^5.55.5",
    "@svgrid/grid": "workspace:^",
    "typescript": "6.0.3",
    "vite": "^8.0.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sv-grid/sv-grid.git",
    "directory": "packages/enterprise"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "sveltekit",
    "data grid",
    "datagrid",
    "data table",
    "excel export",
    "xlsx",
    "pdf export",
    "csv",
    "pivot table",
    "pivot",
    "import",
    "print",
    "kanban",
    "scheduler",
    "svgrid",
    "sv-grid"
  ]
}
