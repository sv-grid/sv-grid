{
  "name": "sv-grid",
  "private": true,
  "version": "0.0.0",
  "description": "SvGrid - a modern Svelte 5 data grid (standalone workspace).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @svgrid/grid-example-gallery dev",
    "build": "pnpm --filter @svgrid/grid build",
    "build:example": "pnpm --filter @svgrid/grid-example-gallery build",
    "test": "pnpm --filter @svgrid/grid test:lib",
    "test:types": "pnpm -r test:types",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.7",
    "playwright": "^1.60.0",
    "typescript": "6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
