{
  "name": "sv-grid",
  "private": true,
  "version": "0.0.0",
  "description": "SvGrid - a modern Svelte 5 data grid (standalone workspace).",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "pnpm --filter @svgrid/grid-example-gallery dev",
    "build": "pnpm --filter @svgrid/grid build",
    "build:example": "pnpm --filter @svgrid/grid-example-gallery build",
    "test": "pnpm --filter @svgrid/grid test:lib",
    "test:types": "pnpm -r test:types",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:e2e:install": "playwright install chromium",
    "lint": "node tools/check-mobile-css.mjs && node tools/check-encoding.mjs && pnpm -r lint",
    "audit:mobile": "node tools/audit-mobile.mjs",
    "size": "node packages/grid/scripts/measure-size.mjs",
    "sbom": "node tools/build-sbom.mjs",
    "sbom:check": "node tools/build-sbom.mjs --check",
    "plugin:sync": "node tools/sync-plugin.mjs",
    "plugin:check": "node tools/sync-plugin.mjs --check",
    "verify:app": "node tools/verify-generated-app.mjs",
    "demos:count": "node tools/count-demos.mjs",
    "thumbs": "node tools/capture-demo-thumbs.mjs",
    "thumbs:check": "node tools/check-demo-thumbs.mjs",
    "changelog": "node tools/build-changelog.mjs",
    "blog:seo": "node tools/twitter/build-tips-pages.mjs && node tools/blog-pillars.mjs && node tools/blog-internal-links.mjs",
    "size:check": "node packages/grid/scripts/measure-size.mjs --check",
    "ssr:check": "node packages/grid/scripts/check-ssr.mjs",
    "node:check": "node packages/grid/scripts/check-node-entry.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.7",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "playwright": "^1.60.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.5"
  }
}
